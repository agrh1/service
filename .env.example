# === Database ===
POSTGRES_USER=microservices
POSTGRES_PASSWORD=microservices
POSTGRES_DB=microservices_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Django portal ===
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# === API Gateway ===
INTRASERVICE_URL=http://intraservice:8001
SEAFILE_SERVICE_URL=http://seafile:8002
DJANGO_URL=http://django:8000
LOG_LEVEL=INFO

# === IntraService credentials ===
INTRASERVICE_USERNAME=demo
INTRASERVICE_PASSWORD=demo

# === Seafile service ===
SEAFILE_URL=https://seafile.example.com
SEAFILE_USERNAME=demo
SEAFILE_PASSWORD=demo
SEAFILE_LIBRARY_ID=demo-library

# === Redis / Celery ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Telegram bot ===
TELEGRAM_BOT_TOKEN=000000:replace-me
TELEGRAM_CHAT_ID=0
METRICS_PORT=9102

# === Monitoring ===
PROMETHEUS_RETENTION_DAYS=15
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# === TLS / reverse proxy ===
NGINX_SERVER_NAME=example.com
NGINX_SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# === Docker registry (CI) ===
REGISTRY=registry.example.com
IMAGE_PREFIX=service
REGISTRY_USERNAME=registry-user
REGISTRY_PASSWORD=registry-password

# === Deployment over SSH ===
DEPLOY_HOST=1.1.1.1
DEPLOY_USER=deploy
DEPLOY_PATH=/srv/service
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# === Telegram notifications for CI ===
TELEGRAM_NOTIFY_TOKEN=000000:replace-me
TELEGRAM_NOTIFY_CHAT_ID=0

# === Backups ===
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
